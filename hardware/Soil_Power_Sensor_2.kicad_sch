	)
	(text "PG AND CHG AND OTHER INDICATORS TO GPIO EXPANDER"
		(exclude_from_sim no)
		(at 207.264 52.832 0)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "12bbe655-621f-458e-a377-9a587cc79af0")
	)
	(text "15-23 mV dropout @ 30 mA\n50-70 mV dropout @ 100 mA"
		(exclude_from_sim no)
		(at 210.566 119.888 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1323a7dc-3c72-4ab1-9ea1-154f78190c22")
	)
	(text "R_{ISET} = K_{ISET} / I_{OUT}\nK_{ISET} typical 395 amp-ohm\nI_{OUT} from 50 mA to 800 mA\n\nR_{ISET} 500 ohm --> I_{OUT} ~800 mA\nR_{ISET} 680 ohm --> I_{OUT} ~580 mA\n\nmin 675 max 10.8k"
		(exclude_from_sim no)
		(at 49.276 152.654 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "355d9135-6848-4bd2-840f-c6d884731299")
	)
	(text "Battery voltage regulation"
		(exclude_from_sim no)
		(at 162.306 21.336 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "734b53bf-af90-480d-8cc3-ff43a08acb86")
	)
	(text "coin cell RTC"
		(exclude_from_sim no)
		(at 61.468 175.514 0)
		(effects
			(font
				(size 5.08 5.08)
			)
		)
		(uuid "98ae72bd-3520-4587-8a9e-74be5cd6e6fb")
	)
	(text "TH1 footprint is just 2 holes since TH1\nneeds to be attached to the battery."
		(exclude_from_sim no)
		(at 105.41 138.176 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b2de5f7a-7ad3-4d88-900a-57f7a30005ad")
	)
	(text "CHECK FOOTPRINT OF ALL MOSFETS"
		(exclude_from_sim no)
		(at 155.448 151.13 0)
		(effects
			(font
				(size 5.08 5.08)
			)
			(justify left top)
		)
		(uuid "b53eb44f-3abd-445e-b2cd-5eea388ec5d8")
	)
	(text "~{EN} tied to ~{PG}\nto auto-enable charge\nand disable load mode"
		(exclude_from_sim no)
		(at 61.976 111.252 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "bf77e058-3ac2-40a5-9ebf-8fe98238f225")
	)
	(text "Battery Connector and Switch"
		(exclude_from_sim no)
		(at 29.464 16.51 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "d6f40817-849b-4066-8b2d-9a381edde3f4")
	)
	(text "RT1\n= (1/V_{V45C}) * RTH(45C) - RTH(45C)\n= (1/0.186) * 5000 - 5000\n= 21.881 kOhm\napprox 21.5 kOhm"
		(exclude_from_sim no)
		(at 99.822 166.37 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "db31835d-2b4f-4637-b1e8-bcb2b8881b41")
