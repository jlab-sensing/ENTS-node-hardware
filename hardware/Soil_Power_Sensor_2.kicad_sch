	(text "VDPM left floating to use\nbattery tracking mode,\ncan be between 1k 10k.\n7.32 kOhm enabled with USB."
		(exclude_from_sim no)
		(at 84.328 79.502 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left top)
		)
		(uuid "0b4e4f7d-c497-4ae1-9c4b-d179dc2892e7")
	)
	(text "Battery Charger"
		(exclude_from_sim no)
		(at 13.462 15.494 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "0ed44f5a-6e12-4f54-83d2-1b449971b249")
	)
	(text "R_{ISET} = K_{ISET} / I_{OUT}\nK_{ISET} is typically 395 amp-ohm\nI_{OUT} ranges from 50 mA to 800 mA\n\nR_{ISET}=500 ohm --> I_{OUT}~=800 mA\nR_{ISET}=680 ohm --> I_{OUT}~=580 mA\n\nmin 675 max 10.8k"
		(exclude_from_sim no)
		(at 55.626 64.262 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left top)
		)
		(uuid "355d9135-6848-4bd2-840f-c6d884731299")
	)
	(text "Voltage Regulation"
		(exclude_from_sim no)
		(at 157.988 15.24 0)
		(effects
			(font
				(size 2.032 2.032)
			)
			(justify left)
		)
		(uuid "6045d200-f85f-4fd5-94d6-0d1b05d4e8bb")
	)
	(text "It is possible for SDI-12 VCC to be as low\nas 3.0 V (low battery, no USB).\n\nTo fix: auto select highest available voltage\n(not to exceed 5.5 V) with ideal ORing diode\nor power mux."
		(exclude_from_sim no)
		(at 202.184 19.558 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "9610d87f-caf9-4990-b912-62e19df086f8")
	)
	(text "coin cell RTC?"
		(exclude_from_sim no)
		(at 175.006 102.108 0)
		(effects
			(font
				(size 2.54 2.54)
			)
		)
		(uuid "98ae72bd-3520-4587-8a9e-74be5cd6e6fb")
	)
	(text "~{EN} tied to ~{PG}\nto auto-enable charge\nand disable load mode"
		(exclude_from_sim no)
		(at 60.198 50.8 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "bf77e058-3ac2-40a5-9ebf-8fe98238f225")
	)
	(text "Recommended solar\npanel V_{OC}=6 V\n(max 18 V input)"
		(exclude_from_sim no)
		(at 16.002 49.53 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "cdc69358-9039-428b-bc7c-2a6303815d1e")
	)
	(text "RT1\n= (1/V_{V45C}) * RTH(45C) - RTH(45C)\n= (1/0.186) * 5000 - 5000\n= 21.881 kOhm\napprox 21.5 kOhm"
		(exclude_from_sim no)
		(at 95.25 64.77 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "db31835d-2b4f-4637-b1e8-bcb2b8881b41")
	)
	(text "Active high enable.\nMode: set low for auto\n(power saving) mode."
		(exclude_from_sim no)
		(at 183.642 62.484 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "fa8b4371-f014-491a-9dd3-3deaaa2d9fef")
	)
	(text "In typical operation,\nwith both inputs\nconnected, V_{solar} < V_{USB}.\n(Usually indoors when\nusing USB input.)\n\nWith V_{USB}=5 V,\nif V_{solar} > V_{USB},\nthen V_{bus} = V_{solar}\nrather than V_{USB}."
		(exclude_from_sim no)
		(at 12.954 58.928 0)
		(effects
			(font
				(size 0.762 0.762)
			)
			(justify left)
		)
		(uuid "fdc35d14-514b-44e6-9170-217b85a30ac9")
	)
